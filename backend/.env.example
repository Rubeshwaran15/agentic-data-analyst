APP_NAME="Agentic AI Data Preprocessing & Quality Analyst"
APP_VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8000

# Security & Resource Limits (16 GB RAM CPU-Only Safe Defaults)
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS_LIMIT=250000
MAX_COLS_LIMIT=500
PREVIEW_ROWS=10

# Local CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Local Ollama AI Runtime
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
OLLAMA_TIMEOUT_SECONDS=90.0
